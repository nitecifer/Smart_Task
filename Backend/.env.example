# Copy this file to ".env" and fill in real values. Never commit .env to Git.

# Port the Express server listens on
PORT=5000

# Where the database lives (matches docker-compose.yml)
DATABASE_URL="postgresql://taskuser:taskpass@localhost:5433/taskmanager?schema=public"

# Secret used to sign login tokens. Use a long random string.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"

# How long a login lasts
JWT_EXPIRES_IN="7d"

# The frontend URL allowed to call this API (Next.js dev server)
CLIENT_URL="http://localhost:3000"

NODE_ENV="development"
